{
  "name": "battlepets",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "yarn:update": "yarn set version stable",
    "clean": "lerna clean --yes",
    "reset": "yarn cache clean && yarn clean && rm -rf node_modules && yarn install",
    "reset:hard": "yarn cache clean && yarn clean && rm -rf node_modules yarn.lock && yarn install",
    "build": "turbo run build",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "audit": "${SKIP_AUDIT:-false} == true || yarn npm audit --all --recursive",
    "audit:ci": "yarn audit --severity high",
    "g:eslint": "cd $INIT_CWD && eslint",
    "g:prettier": "cd $INIT_CWD && prettier",
    "g:stylelint": "cd $INIT_CWD && stylelint",
    "g:lint-staged": "cd $INIT_CWD && lint-staged",
    "precommit": "turbo run precommit --scope=\"*\" --concurrency=1 --since=HEAD --no-deps",
    "preinstall": "npx -y only-allow yarn",
    "postinstall": "${SKIP_POSTINSTALL:-false} == true || husky install"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "@types/eslint": "^8.56.2",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-security": "^2.1.0",
    "eslint-plugin-sort-destructure-keys": "^1.5.0",
    "husky": "^8.0.3",
    "lerna": "^8.1.2",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "stylelint": "^16.1.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-order": "^6.0.4",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "resolutions": {
    "ip": "^2.0.1"
  },
  "packageManager": "yarn@4.0.2"
}
