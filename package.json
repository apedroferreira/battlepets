{
  "name": "battlepets",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "yarn:update": "yarn set version stable",
    "brew": "brew bundle",
    "clean": "lerna clean --yes",
    "reset": "yarn cache clean && yarn clean && rm -rf node_modules && yarn install",
    "reset:hard": "yarn cache clean && yarn clean && rm -rf node_modules yarn.lock && yarn install",
    "build": "turbo run build",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "audit": "${SKIP_AUDIT:-false} == true || yarn npm audit --all --recursive",
    "audit:ci": "yarn audit --severity high",
    "run:script": "ts-node --files --cwd ./scripts",
    "version:add": "yarn changeset",
    "version:apply": "yarn changeset version && yarn install",
    "version:check": "${SKIP_VERSION:-false} == true || yarn run:script checkWorkspaceVersions",
    "g:eslint": "cd $INIT_CWD && eslint",
    "g:prettier": "cd $INIT_CWD && prettier",
    "g:stylelint": "cd $INIT_CWD && stylelint",
    "g:lint-staged": "cd $INIT_CWD && lint-staged",
    "g:ts-node": "cd $INIT_CWD && ts-node",
    "precommit": "turbo run precommit --scope=\"*\" --concurrency=1 --since=HEAD --no-deps",
    "preinstall": "npx -y only-allow yarn",
    "postinstall": "${SKIP_POSTINSTALL:-false} == true || husky"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@types/eslint": "^8.56.12",
    "@types/node": "^20.17.24",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "colors": "^1.4.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "husky": "^9.0.11",
    "lerna": "^8.2.1",
    "lint-staged": "^15.4.3",
    "postcss": "^8.5.3",
    "prettier": "^3.2.5",
    "stylelint": "^16.15.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-order": "^6.0.4",
    "ts-node": "^10.9.2",
    "turbo": "^1.13.3",
    "typescript": "^5.8.2",
    "yargs": "^17.7.2"
  },
  "packageManager": "yarn@4.7.0"
}
