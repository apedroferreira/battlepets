{
  "name": "battlepets-static",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "yarn g:prettier --write '*/**/*.{js,jsx,ts,tsx,md,json}'",
    "lint": "next lint && yarn g:stylelint \"**/*.{css,scss}\"",
    "analyze": "ANALYZE=true yarn build",
    "precommit": "yarn g:lint-staged"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.8.1",
    "modern-normalize": "^2.0.0",
    "next": "14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.33.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.0.4",
    "@types/eslint": "^8.56.2",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.0.4",
    "sass": "^1.69.7"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
