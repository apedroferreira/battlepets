{
  "name": "battlepets-web",
  "version": "1.0.10",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "yarn g:prettier --write '*/**/*.{js,jsx,ts,tsx,md,json}'",
    "lint": "next lint && yarn g:stylelint \"**/*.{css,scss}\"",
    "analyze": "ANALYZE=true yarn build",
    "precommit": "yarn g:lint-staged"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "@next/third-parties": "^14.1.3",
    "@sentry/nextjs": "^7.106.1",
    "@vercel/analytics": "^1.2.2",
    "@vercel/speed-insights": "^1.0.10",
    "battlepets-shared": "workspace:^",
    "modern-normalize": "^2.0.0",
    "next": "14.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "yet-another-react-lightbox": "^3.17.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.1.3",
    "@types/eslint": "^8.56.5",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.21",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.1.3",
    "sass": "^1.71.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
