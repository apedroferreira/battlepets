{
  "name": "battlepets-scripts",
  "version": "1.1.11",
  "private": true,
  "scripts": {
    "run:script": "yarn g:ts-node -r tsconfig-paths/register --cwd ./src/scripts",
    "run:script:safe": "vlt login && REMOTE_SCRIPT_ENV=battlepets-scripts-secrets yarn run:script",
    "build:emails": "yarn run:script convertEmailsToHtml",
    "format": "prettier --write '*/**/*.{js,ts,md,json}'",
    "lint": "eslint \"**/*.{js,ts}\" --fix",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.0",
    "@metaplex-foundation/mpl-token-metadata": "^3.2.1",
    "@metaplex-foundation/umi": "^0.9.1",
    "@metaplex-foundation/umi-bundle-defaults": "^0.9.1",
    "@metaplex-foundation/umi-uploader-irys": "^0.9.1",
    "@metaplex-foundation/umi-web3js-adapters": "^0.9.1",
    "@neondatabase/serverless": "^0.9.3",
    "@solana-developers/helpers": "^2.3.0",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.91.8",
    "battlepets-shared": "workspace:^",
    "colors": "^1.4.0",
    "csv-stringify": "^6.5.0",
    "csvtojson": "^2.0.10",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "get-caller-file": "^2.0.5",
    "html-minifier": "^4.0.0",
    "mjml": "^4.15.3",
    "postmark": "^4.0.2",
    "telegram": "^2.21.2",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/eslint": "^8.56.10",
    "@types/html-minifier": "^4.0.5",
    "@types/mjml": "^4.7.4",
    "@types/node": "^20.12.11",
    "@types/yargs": "^17.0.32",
    "eslint": "^8.57.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "typescript": "^5.4.5"
  }
}
