<mjml>
  <mj-head>
    <mj-attributes>
      <mj-text align="center" color="#202020" font-family="Sora, Helvetica Neue, Helvetica, sans-serif" />
      <mj-section background-color="#fff" />
      <mj-button
        background-color="#7a00b8"
        color="#fff"
        font-family="bernhard-gothic-urw, Sora, Helvetica Neue, Helvetica, sans-serif"
        font-size="20px"
        font-weight="bold"
        text-transform="uppercase"
        inner-padding="20px 42px"
        line-height="1.3"
      />
    </mj-attributes>
    <mj-font name="bernhard-gothic-urw" href="https://use.typekit.net/bjy5uxp.css" />
    <mj-font name="Sora" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;700&display=swap" />
    <mj-preview>Preview content here.</mj-preview>
    <mj-style>@media screen and (max-width: 480px) { .heading-text div { font-size: 28px !important; } } </mj-style>
    <mj-title>A very nice email.</mj-title>
  </mj-head>

  <mj-body background-color="#f8eeff">
    <mj-section background-color="#4e0075" padding-bottom="0">
      <mj-column>
        <mj-image
          href="https://www.battlepets.io"
          width="80px"
          src="https://imagedelivery.net/tQX6spJrZdgf00cBsxL4kQ/bfdc48dc-068d-4954-36f9-3d15e5033300/public"
          alt="Battlepets logo"
          padding-top="0"
        />
        <mj-text
          css-class="heading-text"
          align="center"
          color="#fff"
          font-family="bernhard-gothic-urw, Sora, Helvetica Neue, Helvetica, sans-serif"
          font-size="36px"
          font-weight="bold"
          line-height="1.3"
          >This is a <span style="color: #d000ff">very</span> nice email!</mj-text
        >
        <mj-image
          width="600px"
          src="https://imagedelivery.net/tQX6spJrZdgf00cBsxL4kQ/e5f9ec18-b2ff-47b3-da5d-ffc0460b0600/public"
          alt="Battlepets cards"
          padding="0"
        />
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column padding-left="6.5%" padding-right="6.5%" padding-bottom="30px">
        <mj-text font-size="16px" line-height="1.5" align="left">
          <p>
            Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the
            industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and
            scrambled it to make a type specimen book.
          </p>
          <p>
            It has survived not only five centuries, but also the leap into electronic typesetting, remaining
            essentially unchanged. It was popularised in the 1960s with the release of Letraset sheets containing Lorem
            Ipsum passages, and more recently with desktop publishing software like Aldus PageMaker including versions
            of Lorem Ipsum.
          </p></mj-text
        >
        <mj-button href="https://www.battlepets.io">Don't click me!</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#f8eeff" padding-bottom="4px">
      <mj-group>
        <mj-column>
          <mj-image
            href="https://t.me/battlepets_game"
            alt="Telegram logo"
            align="right"
            height="44px"
            width="44px"
            padding-left="6px"
            padding-right="6px"
            src="https://imagedelivery.net/tQX6spJrZdgf00cBsxL4kQ/c5e8f177-28e1-4f92-3380-36f34a961d00/public"
          />
        </mj-column>
        <mj-column>
          <mj-image
            href="https://twitter.com/battlepets_game"
            alt="X logo"
            align="left"
            padding-left="6px"
            padding-right="6px"
            height="44px"
            width="44px"
            src="https://imagedelivery.net/tQX6spJrZdgf00cBsxL4kQ/aef63962-4b4b-47b0-b518-1110a8ebdd00/public"
          />
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section
      background-color="#f8eeff"
      padding-top="0"
      padding-left="10px"
      padding-right="10px"
      padding-bottom="40px"
    >
      <mj-column>
        <mj-text color="#883fbc" font-size="12px" padding="2px" line-height="1.5"
          >Sent by
          <a href="https://www.battlepets.io" style="color: #d000ff; text-decoration: underline">Battlepets</a
          >.</mj-text
        >
        <mj-text color="#883fbc" font-size="12px" padding="2px" line-height="1.5"
          >© 2024 Battlepets. All rights reserved. |
          <a
            href="{{{ pm:unsubscribe }}}"
            style="
              color: #d000ff;
              font-family:
                Sora,
                Helvetica Neue,
                Helvetica,
                sans-serif;
              text-decoration: underline;
            "
            >Unsubscribe</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
