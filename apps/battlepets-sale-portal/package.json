{
  "name": "battlepets-sale-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "format": "yarn g:prettier --write '*/**/*.{js,jsx,ts,tsx,md,json}'",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 && yarn g:stylelint \"**/*.{css,scss}\"",
